{
  "schemaVersion": 1,
  "id": "wb-cinderzhan-dsh-media-workbench",
  "title": "内容运营工作台",
  "description": "选题、达人、Campaign、排期及数据管理，保留四窗口与原生会话。",
  "version": "0.12.3",
  "entry": "./packages/dsh-media-workbench/client.js",
  "compatibility": {
    "desktopWorkbenches": "^0.1.0",
    "harness": "^0.1.5-rc.2"
  },
  "capabilities": [
    "custom-frame",
    "local-business-storage",
    "managed-session-association",
    "native-conversation-draft",
    "scheduled-metrics-collection"
  ],
  "permissions": {
    "filesystem": "业务目录保留原版规则，由显式会话操作关联为工作区。",
    "network": "沿用作品指标读取、可选独立浏览器采集及用户配置的模型服务。"
  },
  "initialization": "empty",
  "customFrame": true
}
